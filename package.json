{
  "name": "dsh-notifications",
  "version": "0.1.1",
  "description": "Desktop notifications and a local chime for DSH main-thread completion and requests for attention",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Dat LQ.",
    "url": "https://github.com/dat-lequoc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dat-lequoc/dsh-notifications.git"
  },
  "bugs": {
    "url": "https://github.com/dat-lequoc/dsh-notifications/issues"
  },
  "homepage": "https://github.com/dat-lequoc/dsh-notifications#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "notifications",
    "desktop-notifications"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build && node --check lib/client.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@playwright/test": "^1.58.0"
  },
  "engines": {
    "node": "^22.19 || >=24"
  }
}
